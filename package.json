{
  "name": "devolucoes-app",
  "version": "1.0.0",
  "description": "Controle diário de devoluções - SINTA-SE LINDA & Galpão Utilidades",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "test": "node --test tests/*.test.js",
    "share": "bash scripts/share.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.10"
  }
}
